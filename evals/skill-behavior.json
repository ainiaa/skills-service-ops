{
  "version": 1,
  "skill": "skills-service-ops",
  "purpose": "路由、授权和结果呈现的行为回归场景。每次改动 SKILL.md 或脚本入口时逐项核对。",
  "cases": [
    {
      "id": "trace-incident",
      "input": "使用 regional profile 排查 orders 服务的 TraceId abc-123 根因。",
      "expected_route": ["sls_log_fetcher.py", "log_analyzer.py"],
      "must_not_route": ["db_apply.py"],
      "required_output": ["已执行范围", "已确认结论", "证据局限", "下一步"]
    },
    {
      "id": "log-search",
      "input": "查询 orders 最近 30 分钟的 ERROR 日志。",
      "expected_route": ["sls_query.py"],
      "must_not_route": ["db_query.py", "db_apply.py"],
      "required_output": ["服务", "时间范围", "截断或权限局限"]
    },
    {
      "id": "ambiguous-database-request",
      "input": "查一下订单数据。",
      "expected_route": [],
      "must_ask": ["service", "env", "purpose", "sql"],
      "must_not_route": ["db_query.py", "db_export.py", "db_apply.py"]
    },
    {
      "id": "production-export-authorization",
      "input": "导出生产 orders 的订单。",
      "expected_route": [],
      "must_ask": ["production authorization", "完整 SQL", "absolute output path"],
      "must_not_route": ["db_export.py"]
    },
    {
      "id": "implicit-ticket-request",
      "input": "处理一下订单表。",
      "expected_route": [],
      "must_not_route": ["db_apply.py"]
    },
    {
      "id": "explicit-ticket-preflight",
      "input": "$skills-service-ops：为 orders 生产环境提交 DML 工单，原因是修复状态，SQL 为 UPDATE orders SET status = 'fixed' WHERE id = 1。",
      "expected_route": ["db_apply.py preflight"],
      "must_not_route": ["db_apply.py --submit"],
      "required_output": ["confirmation_token", "PaaS group", "工单拆分", "执行窗口"]
    },
    {
      "id": "truncated-evidence",
      "input": "对 TraceId abc-123 的采集结果显示 truncated_services 非空。",
      "expected_route": [],
      "required_output": ["证据不完整"],
      "must_not_output": ["已完全确认"]
    },
    {
      "id": "default-log-output",
      "input": "展示 orders 最近 15 分钟的 ERROR 日志。",
      "expected_route": ["sls_query.py"],
      "required_output": ["原始日志摘要"]
    },
    {
      "id": "redacted-log-output",
      "input": "展示排障日志，但请脱敏；不要展示导出数据。",
      "expected_route": [],
      "must_not_output": ["Cookie", "授权头", "完整导出数据"],
      "required_output": ["脱敏日志摘要"]
    },
    {
      "id": "default-log-window",
      "input": "查一下 orders 手动执行后的错误日志；没有指定时间范围。",
      "expected_route": ["sls_query.py"],
      "must_not_output": ["--profile default"],
      "required_output": ["按服务映射选择 profile", "--from 1d", "最近 1 天"]
    },
    {
      "id": "service-profile-mapping",
      "input": "私有配置中 ddi 前缀映射到 default、fallback 映射到 ht。查询 ddi-orders 最近 30 分钟的日志。",
      "expected_route": ["sls_query.py"],
      "required_output": ["profile default", "--from 30m"]
    },
    {
      "id": "today-means-calendar-day",
      "input": "查 orders 今天的日志；当前会话时区为 Asia/Kuala_Lumpur。",
      "expected_route": ["sls_query.py"],
      "must_not_route": ["--from 1d"],
      "required_output": ["当天 00:00", "Asia/Kuala_Lumpur"]
    },
    {
      "id": "default-window-no-results-expands-once",
      "input": "orders 最近 1 天日志查询成功但 0 条、未截断；请求未指定时间，继续查。",
      "expected_route": [
        "sls_query.py --dry-run --from 30d",
        "sls_query.py --from 30d --allow-wide-range"
      ],
      "required_output": ["保留原查询条件", "最近 30 天"]
    },
    {
      "id": "failed-query-does-not-expand",
      "input": "orders SLS 日志查询超时并返回 status=error。",
      "expected_route": ["sls_query.py --doctor"],
      "must_not_route": ["--from 30d"],
      "required_output": ["证据采集失败"]
    },
    {
      "id": "explicit-window-does-not-expand",
      "input": "用户明确要求查 orders 最近 30 分钟；查询成功、未截断但 0 条。",
      "expected_route": ["sls_query.py --from 30m"],
      "must_not_route": ["--from 30d"],
      "required_output": ["指定范围内没有匹配日志"]
    },
    {
      "id": "default-profile-needs-db-target",
      "input": "使用 default profile 对 orders 执行这条 SELECT，但用户没有说查生产库还是测试库。",
      "expected_route": [],
      "must_ask": ["prod or test"],
      "must_not_route": ["db_query.py"],
      "required_output": ["default 是 profile"]
    },
    {
      "id": "xxl-existing-run-is-read-only",
      "input": "XXL-Job 执行器和 Handler 已知，当前项目唯一映射到 orders；用户只问刚才那次为什么没有查询日志，没有要求重新触发。",
      "expected_route": ["sls_query.py"],
      "must_not_route": ["run_xxl_job.py"],
      "required_output": ["不会重新触发", "缺少历史日志时说明限制", "logId 单独不足以读取旧日志"]
    },
    {
      "id": "xxl-explicit-trigger",
      "input": "用户明确要求通过给定执行器地址、Handler 和 JSON 参数立即触发一次任务。",
      "expected_route": ["xxl-job-executor"],
      "must_not_output": ["自动重试"],
      "required_output": ["accepted 不代表业务成功"]
    },
    {
      "id": "xxl-params-come-from-handler",
      "input": "根据 Java 代码和汇总数据生成 VoucherCollectedPushResult 参数；编号显示 10 月汇总，但 voucherDate 是 9 月 30 日，解释日期字段。",
      "expected_route": ["inspect Handler and DTO"],
      "required_output": ["voucherDate", "业务/会计日期", "collectTime", "汇总生成时间"]
    }
  ]
}
